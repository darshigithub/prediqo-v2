# Active Provider: openai | groq | gemini | anthropic | custom
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (Ultra-fast inference: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude (claude-3-5-sonnet-20241022, claude-3-haiku-20240307)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Custom / Local / OpenAI-Compatible (Ollama, DeepSeek, vLLM, LMStudio)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
